{
  "name": "precifica3d",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "prisma dev --name precifica3d",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "check:pricing": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/check-pricing.ts",
    "check:market": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/check-market.ts",
    "market:collect": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/collect-market.ts",
    "user:create": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env scripts/create-user.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
